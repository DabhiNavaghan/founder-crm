# Settings for the FoundReach daily automation.
# Lives at /home/opc/apps/foundreach-agents/.env with mode 600. Never commit the filled-in file.
# Write values without quotes and without spaces around "=".

# --- The two secrets you must add -------------------------------------------------------------

# 1. Claude Code token for unattended runs. Create it once on any machine with a browser:
#      claude setup-token
#    and paste the result here. Without it the AI stages do not run (the collection job still does,
#    and you get a short email saying why, once SMTP is set).
CLAUDE_CODE_OAUTH_TOKEN=

# 2. SMTP account that sends the daily report. Port 25 is blocked on Oracle Cloud; use 587
#    (STARTTLS) or 465 (TLS). For Gmail: host smtp.gmail.com, port 587, your address as the user,
#    and an app password (not the account password) as SMTP_PASS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Report -------------------------------------------------------------------------------------

# Sender address (defaults to SMTP_USER) and recipients (comma-separated).
REPORT_FROM=
REPORT_TO=dabhinavaghan6@gmail.com

# --- Behaviour ----------------------------------------------------------------------------------

# 0: every change waits as a pull request for you to merge (default).
# 1: a change is merged, deployed to production and rolled out to the container on this server
#    without you, but only when the review says PASS, the build and tests pass, and it contains no
#    database migration and no change to pipeline, deployment or package files.
AUTO_MERGE=0

# Sources left out of the daily load into the catalog (comma-separated source slugs).
# a16z and 500-global are on hold until you decide about their terms. Empty means load everything.
COLLECT_EXCLUDE=a16z,500-global

# --- Optional -----------------------------------------------------------------------------------

# Model for the AI stages (an alias such as sonnet or opus, or a full model name). Empty: the CLI default.
AGENT_MODEL=

# Time limit for the AI stages of one run, in minutes (default 150).
DAILY_MAX_MINUTES=

# Time limit for the collection job, in minutes (default 50).
COLLECT_MAX_MINUTES=

# Commit author for the daily branches. Defaults: Navghan Dabhi and the git email of this user.
GIT_IDENTITY_NAME=
GIT_IDENTITY_EMAIL=

# Stage sandbox. Leave empty: on this server every stage runs in a locked-down systemd unit.
# "none" turns that off; do not set it unless you understand automation/README.md, "Security model".
AGENT_SANDBOX=

# Memory limit for one stage (default 3G).
AGENT_MEMORY_MAX=

# Set to 0 to stop the run from updating the container on this server after an automatic merge.
UPDATE_CONTAINER=
