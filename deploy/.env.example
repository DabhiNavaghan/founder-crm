# Runtime settings for the FoundReach container.
# Copy to /home/opc/apps/foundreach/.env, fill in the values, then: chmod 600 .env
# Write values without quotes. Never commit the filled-in file.

# --- Required ---------------------------------------------------------------------------------

# Supabase project URL and publishable (anon) key. The same values the browser bundle was built
# with; the server-side pages and the daily refresh use them to call the database.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Clerk secret key (sk_live_... / sk_test_...). Verifies the signed-in user on /api/generate-message.
CLERK_SECRET_KEY=

# Shared secret for the daily refresh (/api/cron/refresh). At least 16 characters, and it must be
# the same value the database holds for the cron functions. When it is set, the container runs the
# schedule from vercel.json by itself (currently 06:00 UTC daily); nothing has to be added to the host's crontab.
CRON_SECRET=

# --- Optional ---------------------------------------------------------------------------------

# OpenAI key for AI-written messages. Without it /api/generate-message answers with an error.
OPENAI_API_KEY=

# Public address of the site, used in canonical links and the sitemap.
# Leave empty for the default, https://foundreach.navaghandabhi.dev
SITE_URL=

# Set to 0 to stop this container from running the cron schedule, for example while Vercel Cron is
# still calling the same endpoint. Leave empty to keep it on.
ENABLE_CRON=

# Set to 0 to turn off the in-memory page cache (pages that send CDN-Cache-Control: s-maxage).
EDGE_CACHE=

# Image version to run: latest, or a short commit SHA to pin or roll back. Read by docker compose.
IMAGE_TAG=latest
