{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/companies", "destination": "/api/directory?view=list" },
    { "source": "/companies/:slug", "destination": "/api/directory?view=company&slug=:slug" },
    { "source": "/new", "destination": "/api/directory?view=new" },
    { "source": "/sector/:preset", "destination": "/api/directory?view=sector&preset=:preset" },
    { "source": "/sector/:preset/:preset2", "destination": "/api/directory?view=sector-city&preset=:preset&preset2=:preset2" },
    { "source": "/city/:preset", "destination": "/api/directory?view=city&preset=:preset" },
    { "source": "/batch/:preset", "destination": "/api/directory?view=batch&preset=:preset" },
    { "source": "/source/:preset", "destination": "/api/directory?view=source&preset=:preset" },
    { "source": "/hiring", "destination": "/api/directory?view=hiring" },
    { "source": "/hiring/:preset", "destination": "/api/directory?view=hiring-sector&preset=:preset" },
    { "source": "/collections", "destination": "/api/directory?view=collections" },
    { "source": "/collections/:preset", "destination": "/api/directory?view=collection&preset=:preset" },
    { "source": "/about-data", "destination": "/api/directory?view=about" },
    { "source": "/directory.js", "destination": "/api/directory?view=script" },
    { "source": "/api/public/stats", "destination": "/api/directory?view=stats" },
    { "source": "/sitemap.xml", "destination": "/api/directory?view=sitemap" },
    { "source": "/sitemap-pages.xml", "destination": "/api/directory?view=sitemap&part=pages" },
    { "source": "/sitemap-companies.xml", "destination": "/api/directory?view=sitemap&part=companies" },
    { "source": "/remove", "destination": "/api/remove" },
    { "source": "/app", "destination": "/index.html" },
    { "source": "/app/:path*", "destination": "/index.html" }
  ],
  "crons": [{ "path": "/api/cron/refresh", "schedule": "0 6 * * *" }],
  "functions": {
    "api/cron/refresh.js": { "maxDuration": 60 },
    "api/directory.js": { "maxDuration": 15 },
    "api/remove.js": { "maxDuration": 15 }
  }
}
